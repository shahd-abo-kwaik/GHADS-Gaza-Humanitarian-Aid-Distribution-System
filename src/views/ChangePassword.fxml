<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.ChangePasswordController"
            stylesheets="@../css/style.css"
            prefWidth="900" prefHeight="600"
            styleClass="dashboard-root">

    <top>
        <MenuBar>
            <Menu text="File">
                <MenuItem text="Exit" onAction="#handleExit"/>
            </Menu>
            <Menu text="Help">
                <MenuItem text="About App" onAction="#handleAboutApp"/>
            </Menu>
        </MenuBar>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="20">
            <VBox spacing="16" styleClass="login-card" maxWidth="430">
                <Label text="Change Password" styleClass="login-title"/>

                <Label text="Current Password" styleClass="field-label"/>
                <PasswordField fx:id="currentPasswordField" promptText="Enter current password"/>

                <Label text="New Password" styleClass="field-label"/>
                <PasswordField fx:id="newPasswordField" promptText="Enter new password"/>

                <Label text="Confirm Password" styleClass="field-label"/>
                <PasswordField fx:id="confirmPasswordField" promptText="Confirm new password"/>

                <HBox spacing="12">
                    <Button text="Change Password" onAction="#handleChangePassword" styleClass="login-button"/>
                    <Button text="Reset" onAction="#handleReset" styleClass="login-button"/>
                </HBox>
            </VBox>
        </VBox>
    </center>

</BorderPane>